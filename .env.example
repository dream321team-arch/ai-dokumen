# OpenRouter API Configuration (Primary LLM Reviewer — bisa tunnel provider pihak ketiga)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# OpenRouter Fallback Configuration (dipakai otomatis jika OPENROUTER_* primer di atas gagal/error)
OPENROUTER_FALLBACK_API_KEY=your_openrouter_fallback_api_key_here
OPENROUTER_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o

# NVIDIA API Configuration (Fallback & Embeddings/Reranking)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking

# Anthropic Configuration
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# System Parameters
CHROMA_PERSIST_DIR=./.chroma_data
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
